{
  "format": "rnnet.conformance-vectors.v1",
  "profile": "rnnet.canonical-json.v1",
  "kind": "canonical-valid",
  "vectors": [
    {
      "id": "key-order",
      "description": "Object keys are sorted.",
      "input": "{\"b\":2,\"a\":1,\"c\":3}",
      "expected": "{\"a\":1,\"b\":2,\"c\":3}",
      "expectedSha256": "e6a3385fb77c287a712e7f406a451727f0625041823ecf23bea7ef39b2e39805"
    },
    {
      "id": "whitespace",
      "description": "Insignificant whitespace (space, tab, LF, CR) is removed.",
      "input": " \t\n\r{ \"a\" : [ 1 , 2 ] }\r\n",
      "expected": "{\"a\":[1,2]}",
      "expectedSha256": "01530d164d479cf08e26d3b1ad9bdba927120d97e2d057a6d792db778780d720"
    },
    {
      "id": "nested-sorting",
      "description": "Nested objects are sorted; array order is kept.",
      "input": "{\"z\":{\"y\":1,\"x\":[{\"b\":1,\"a\":2}]},\"a\":null}",
      "expected": "{\"a\":null,\"z\":{\"x\":[{\"a\":2,\"b\":1}],\"y\":1}}",
      "expectedSha256": "e33b0495e6bfd853be253c19aaa57f977ec9505335ac471806e7ee264f8cef14"
    },
    {
      "id": "array-order",
      "description": "Array order is data.",
      "input": "[3,1,2]",
      "expected": "[3,1,2]",
      "expectedSha256": "51bda7ab4e44726cde71fcb6e4b515357059bb6b6dd5146d1fc50f73f11678c6"
    },
    {
      "id": "empty-containers",
      "description": "Empty object and array.",
      "input": "{ \"b\" : [ ] , \"a\" : { } }",
      "expected": "{\"a\":{},\"b\":[]}",
      "expectedSha256": "aeeba1e56a144077f89e26c930dad7cf933e9383cfb8e33ddff618233b29be76"
    },
    {
      "id": "literals",
      "description": "true, false and null.",
