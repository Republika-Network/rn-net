      "expected": "[true,false,null]",
      "expectedSha256": "4d0f18de2133118249c26acc481838d4f6bb6bc1de882d99abbd19ae9397e8df"
    },
    {
      "id": "top-level-string",
      "description": "A scalar may be the top-level value.",
      "input": " \"x\" ",
      "expected": "\"x\"",
