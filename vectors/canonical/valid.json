      "expected": "\"\u00e9\"",
      "expectedSha256": "f2886017e9c7abacf804b54d64787dce2b611c9544ba21f3affdd126a6e50086"
    },
    {
      "id": "non-ascii-literal",
      "description": "The same character given as UTF-8 bytes canonicalizes identically.",
      "inputHex": "22c3a922",
      "expected": "\"\u00e9\"",
      "expectedSha256": "f2886017e9c7abacf804b54d64787dce2b611c9544ba21f3affdd126a6e50086"
    },
    {
      "id": "non-ascii-uppercase-escape",
      "description": "Escape hex digits may be uppercase in the input.",
      "input": "\"\\u00E9\"",
      "expected": "\"\u00e9\"",
      "expectedSha256": "f2886017e9c7abacf804b54d64787dce2b611c9544ba21f3affdd126a6e50086"
    },
    {
